# Baaspilt: Airflow koos Python 3.10 (stabiilsem PyArrow jaoks)
FROM apache/airflow:2.8.1-python3.10

# Luba root õigused süsteemi sõltuvuste paigaldamiseks
USER root

# Paigalda vajalikud süsteemi tööriistad
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Vaheta tagasi airflow kasutaja
USER airflow

# Uuenda pip ja wheel, et saada prebuilt wheel'id
RUN pip install --upgrade pip setuptools wheel

# Paigalda Python paketid ilma liiga rangete versioonipiiranguteta
RUN pip install --no-cache-dir \
    duckdb \
    pandas \
    clickhouse-driver \
    "pyarrow>=12.0.0,<16.0.0" \
    pyiceberg \
    dbt-core \
    dbt-clickhouse

# Töökataloog DAGs ja skriptide jaoks
WORKDIR /opt/airflow

# ENTRYPOINT jääb samaks, Airflow entrypoint on juba defineeritud
