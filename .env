# Postgres (Airflow)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# ClickHouse
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=password

# MinIO
MINIO_ROOT_USER=minio_user
MINIO_ROOT_PASSWORD=minio_pass

# MySQL (OpenMetadata)
OM_MYSQL_ROOT_PASSWORD=password
OM_MYSQL_DB=openmetadata_db
OM_MYSQL_USER=openmetadata
OM_MYSQL_PASSWORD=openmetadata

# OpenMetadata server
DB_USER=${OM_MYSQL_USER}
DB_PASSWORD=${OM_MYSQL_PASSWORD}
OM_DATABASE=${OM_MYSQL_DB}
